#: admin/class-st-metabox.php
msgid "Testimonial Details"
msgstr "Данные отзыва"

#: admin/class-st-metabox.php
msgid "Position / Company"
msgstr "Должность / компания"

#: admin/class-st-metabox.php
msgid "Optional. Up to 100 characters."
msgstr "Необязательно. До 100 символов."

#: admin/class-st-metabox.php
msgid "Rating"
msgstr "Оценка"

#: admin/class-st-metabox.php
#, php-format
msgid "%d out of 5"
msgstr "%d из 5"

#: admin/class-st-metabox.php
msgid "Author Email"
msgstr "Email автора"

#: admin/class-st-metabox.php
msgid "Admin only. Never displayed on the public site."
msgstr "Только для администратора, на сайте не выводится."

#: admin/class-st-metabox.php
msgid "Author Website URL"
msgstr "Ссылка на сайт автора"

#: admin/class-st-metabox.php
msgid "Optional. Must start with http:// or https://."
msgstr "Необязательно. Должна начинаться с http:// или https://."

#: admin/class-st-metabox.php
msgid "Position / Company was truncated to 100 characters."
msgstr "Поле «Должность / компания» было сокращено до 100 символов."

#: admin/class-st-metabox.php
msgid "Rating must be a number between 1 and 5. Default rating (5) was applied."
msgstr "Оценка должна быть числом от 1 до 5. Установлена оценка по умолчанию (5)."

#: admin/class-st-metabox.php
msgid "Invalid Author Email format. The email field was not saved."
msgstr "Некорректный формат Email автора. Поле Email не было сохранено."

#: admin/class-st-metabox.php
msgid "Invalid Author Website URL. Please enter a valid http:// or https:// address."
msgstr "Некорректный URL сайта автора. Укажите правильный адрес с http:// или https://."

#: admin/class-st-metabox.php
msgid "Company"
msgstr "Компания"

#: admin/class-st-settings.php
msgid "Testimonials Settings"
msgstr "Настройки отзывов"

#: admin/class-st-settings.php
msgid "Settings"
msgstr "Настройки"

#: admin/class-st-settings.php
msgid "General Settings"
msgstr "Основные настройки"

#: admin/class-st-settings.php
msgid "Default Testimonials Count"
msgstr "Количество отзывов по умолчанию"

#: admin/class-st-settings.php
msgid "Visitor Submission Form"
msgstr "Форма для посетителей"

#: admin/class-st-settings.php
msgid "Email Notifications"
msgstr "Email-уведомления"

#: admin/class-st-settings.php
msgid "Notification Email"
msgstr "Email для уведомлений"

#: admin/class-st-settings.php
msgid "Star Rating Color"
msgstr "Цвет звёзд"

#: admin/class-st-settings.php
msgid "Uninstall Behavior"
msgstr "Удаление данных"

#: admin/class-st-settings.php
msgid "Configure default display options, visitor submissions, and moderation alerts."
msgstr "Настройте параметры вывода отзывов по умолчанию, форму для посетителей и уведомления о модерации."

#: admin/class-st-settings.php
msgid "Please enter a valid notification email address. Reverted to previous valid email."
msgstr "Укажите корректный Email для уведомлений. Восстановлен предыдущий допустимый адрес."

#: admin/class-st-settings.php
msgid "Used by [testimonials] shortcode and Gutenberg block when count is not explicitly set."
msgstr "Используется в шорткоде [testimonials] и блоке Gutenberg, если количество не задано явно."

#: admin/class-st-settings.php
msgid "Enable public submission form via [testimonial_form] shortcode"
msgstr "Включить форму отправки отзывов на сайте через шорткод [testimonial_form]"

#: admin/class-st-settings.php
msgid "Send an email notification when a new testimonial awaits moderation"
msgstr "Отправлять уведомление на email, когда новый отзыв ожидает модерации"

#: admin/class-st-settings.php
msgid "Defaults to the site administrator email if left blank."
msgstr "По умолчанию используется основной email администратора сайта."

#: admin/class-st-settings.php
msgid "Delete all testimonials and categories when uninstalling the plugin"
msgstr "Удалять все отзывы и категории при полном удалении плагина"

#: admin/class-st-settings.php
msgid "Save Settings"
msgstr "Сохранить настройки"

#: public/class-st-shortcode.php
#, php-format
msgid "Rating: %d out of 5"
msgstr "Оценка: %d из 5"

#: public/class-st-form.php
msgid "Submitting..."
msgstr "Отправка..."

#: public/class-st-form.php
msgid "Please fill in your name and testimonial text."
msgstr "Пожалуйста, заполните обязательные поля (имя и текст отзыва)."

#: public/class-st-form.php
msgid "Please enter a valid email address."
msgstr "Пожалуйста, укажите корректный Email адрес."

#: public/class-st-form.php
msgid "Something went wrong while submitting your testimonial. Please try again."
msgstr "Произошла ошибка при отправке отзыва. Попробуйте ещё раз."

#: public/class-st-form.php
msgid "Leave this field empty"
msgstr "Оставьте это поле пустым"

#: public/class-st-form.php
msgid "Your Name"
msgstr "Ваше имя"

#: public/class-st-form.php
msgid "Your Email"
msgstr "Ваш Email"

#: public/class-st-form.php
#, php-format
msgid "%d out of 5 stars"
msgstr "%d из 5 звёзд"

#: public/class-st-form.php
msgid "Your Testimonial"
msgstr "Текст отзыва"

#: public/class-st-form.php
msgid "Submit Testimonial"
msgstr "Отправить отзыв"

#: public/class-st-form.php
msgid "Testimonial submissions are currently disabled."
msgstr "Приём новых отзывов временно отключён."

#: public/class-st-form.php
msgid "Security verification failed. Please refresh the page and try again."
msgstr "Ошибка проверки безопасности. Обновите страницу и попробуйте снова."

#: public/class-st-form.php
msgid "Spam submission blocked."
msgstr "Отправка заблокирована защитой от спама."

#: public/class-st-form.php
msgid "You have recently submitted a testimonial. Please wait 60 seconds before submitting another."
msgstr "Вы уже отправляли отзыв недавно. Пожалуйста, подождите 60 секунд перед повторной отправкой."

#: public/class-st-form.php
msgid "Please select a rating between 1 and 5."
msgstr "Пожалуйста, выберите оценку от 1 до 5."

#: public/class-st-form.php
msgid "Could not save your testimonial. Please try again later."
msgstr "Не удалось сохранить отзыв. Пожалуйста, попробуйте позже."

#: public/class-st-form.php
msgid "Thank you! Your testimonial has been submitted and will appear once approved by a moderator."
msgstr "Спасибо! Ваш отзыв успешно отправлен и появится на сайте после проверки модератором."

#: public/class-st-form.php
#, php-format
msgid "[%s] New testimonial awaiting moderation"
msgstr "[%s] Новый отзыв ожидает модерации"

#: public/class-st-form.php
msgid "A new client testimonial has been submitted and is awaiting moderation:"
msgstr "На сайте оставлен новый отзыв клиента, ожидающий модерации:"

#: public/class-st-form.php
#, php-format
msgid "Author: %s"
msgstr "Автор: %s"

#: public/class-st-form.php
#, php-format
msgid "Position / Company: %s"
msgstr "Должность / компания: %s"

#: public/class-st-form.php
#, php-format
msgid "Email: %s"
msgstr "Email: %s"

#: public/class-st-form.php
msgid "Testimonial:"
msgstr "Текст отзыва:"

#: public/class-st-form.php
#, php-format
msgid "Review and moderate: %s"
msgstr "Проверить и модерировать: %s"

